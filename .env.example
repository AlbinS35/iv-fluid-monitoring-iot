# ==============================================================================
# Environment Configuration - Smart IV Infusion Telematics
# ==============================================================================

# PostgreSQL Target URI (used by web service)
DATABASE_URL=postgresql://postgres:postgres@db:5432/iv_telematics

# PostgreSQL Container Credentials (used by db service)
POSTGRES_DB=iv_telematics
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Application Port
PORT=5000
